# Object storage holding the article sources. Without it the site falls back to
# the .mdx files committed under app/content/articles, which is what a local
# clone runs on.
#
# In the cluster these come from the lalter-www-s3 ExternalSecret, mirroring
# what the kube-infra buckets stack provisions — the values below are only for
# running against the bucket from a workstation.
S3_ENDPOINT=https://s3.gra.io.cloud.ovh.net
S3_REGION=gra
S3_BUCKET=lalternative-prod-content
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Applications, subscribers and the admin's article index. The public site never
# reads it: an article renders whether or not this is reachable.
DATABASE_URL=postgres://user:password@localhost:5432/lalter

# Admin authentication. BETTER_AUTH_URL is the origin the app is served from —
# the sign-in links are built from it.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Transactional mail, through Spore. Sign-in requires a verified address, so
# until these are set and the sending domain is verified nobody can sign in —
# the first admin included.
#
# The key is minted from app.sporee.fr and looks like sk_live_*. It is scoped to
# a tenant, not to a domain: what authorises this address is the identity behind
# SPORE_FROM, whose DKIM and SPF records must be published and verified first.
SPORE_API_KEY=
SPORE_FROM=noreply@lalter.org

# Optional gates on /admin/setup, the first-admin bootstrap reachable with no
# session. Without either, whoever reaches the route first can create the
# account — the OTP only proves they control the address they typed, not that
# they are authorized to become admin. Set ADMIN_SETUP_TOKEN and pass it as
# ?token=... on /admin/setup; set ADMIN_ALLOWED_EMAILS (comma-separated) to
# restrict which address may claim the role. Both unset preserves the previous
# (open) behavior.
ADMIN_SETUP_TOKEN=
ADMIN_ALLOWED_EMAILS=
